<% if (success_msg) { %>
    <div class="flash-banner mb-4 p-4 rounded-xl bg-green-50 border border-green-200 text-green-800 text-sm font-medium flex justify-between items-center shadow-sm transition-all duration-300">
        <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-green-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span><%= success_msg %></span>
        </div>
        <button onclick="this.parentElement.remove()" class="text-green-600 hover:text-green-800 text-lg leading-none font-bold ml-3">&times;</button>
    </div>
<% } %>

<% if (error_msg) { %>
    <div class="flash-banner mb-4 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm font-medium flex justify-between items-center shadow-sm transition-all duration-300">
        <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-red-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span><%= error_msg %></span>
        </div>
        <button onclick="this.parentElement.remove()" class="text-red-600 hover:text-red-800 text-lg leading-none font-bold ml-3">&times;</button>
    </div>
<% } %>

<% if (info_msg) { %>
    <div class="flash-banner mb-4 p-4 rounded-xl bg-indigo-50 border border-indigo-200 text-indigo-800 text-sm font-medium flex justify-between items-center shadow-sm transition-all duration-300">
        <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-indigo-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span><%= info_msg %></span>
        </div>
        <button onclick="this.parentElement.remove()" class="text-indigo-600 hover:text-indigo-800 text-lg leading-none font-bold ml-3">&times;</button>
    </div>
<% } %>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        setTimeout(() => {
            const banners = document.querySelectorAll('.flash-banner');
            banners.forEach(banner => {
                banner.style.opacity = '0';
                banner.style.transform = 'translateY(-8px)';
                setTimeout(() => banner.remove(), 300);
            });
        }, 4000);
    });
</script>
