<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analytics - Admin Portal</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="/js/chart.min.js"></script>
    <!-- Fallback if local fails -->
    <script>
        if (typeof Chart === 'undefined') {
            document.write('<script src="https://cdn.jsdelivr.net/npm/chart.js"><\/script>');
        }
    </script>
    <meta name="csrf-token" content="<%= csrfToken %>">
</head>

<body class="bg-slate-50 font-sans min-h-screen flex">

    <!-- Mobile Sidebar Overlay -->
    <div id="sidebarOverlay"
        class="fixed inset-0 bg-slate-900/50 z-20 hidden md:hidden backdrop-blur-sm transition-opacity duration-300 opacity-0">
    </div>

    <!-- Sidebar (Consistent with Dashboard) -->
    <aside id="adminSidebar"
        class="fixed inset-y-0 left-0 w-64 bg-slate-900 border-r border-slate-800 z-30 transform -translate-x-full md:translate-x-0 md:static md:flex md:flex-col transition-transform duration-300 ease-in-out text-slate-300">
        <div class="h-16 flex items-center justify-between px-6 border-b border-slate-800 text-white font-bold text-lg">
            <span>Admin Portal</span>
            <button id="closeSidebar" class="md:hidden text-slate-400 hover:text-white">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <nav class="flex-1 py-4 px-2 space-y-1">
            <a href="/admin/dashboard"
                class="group flex items-center px-4 py-2.5 text-sm font-medium hover:bg-slate-800 hover:text-white rounded-lg transition-colors">Dashboard</a>
            <a href="/admin/staff"
                class="group flex items-center px-4 py-2.5 text-sm font-medium hover:bg-slate-800 hover:text-white rounded-lg transition-colors">Staff
                List</a>
            <a href="/admin/attendance"
                class="group flex items-center px-4 py-2.5 text-sm font-medium hover:bg-slate-800 hover:text-white rounded-lg transition-colors">Attendance
                Logs</a>
            <a href="/admin/analytics"
                class="group flex items-center px-4 py-2.5 text-sm font-medium bg-indigo-600 text-white rounded-lg transition-colors">Analytics</a>
            <a href="/admin/settings"
                class="group flex items-center px-4 py-2.5 text-sm font-medium hover:bg-slate-800 hover:text-white rounded-lg transition-colors">Settings</a>
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 overflow-y-auto w-full">
        <header
            class="bg-white shadow-sm border-b border-slate-200 px-4 sm:px-8 py-4 flex justify-between items-center sticky top-0 z-10">
            <div class="flex items-center gap-3">
                <button id="openSidebar" class="md:hidden text-slate-600 hover:text-slate-900 focus:outline-none">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
                <h1 class="text-xl sm:text-2xl font-bold text-slate-800">Analytics</h1>
            </div>
            <div class="text-sm text-slate-500 hidden sm:block">Real-time Data Visualization</div>
        </header>

        <div class="max-w-7xl mx-auto p-8 space-y-8">

            <!-- Row 1: Daily Status & Distribution -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

                <!-- Daily Bar Chart -->
                <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100">
                    <h2 class="text-lg font-semibold text-slate-700 mb-4">Today's Status</h2>
                    <canvas id="dailyBarChart" height="200"></canvas>
                </div>

                <!-- Daily Distribution (Doughnut) -->
                <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100 flex flex-col items-center">
                    <h2 class="text-lg font-semibold text-slate-700 mb-4">Attendance Health</h2>
                    <div class="w-2/3">
                        <canvas id="distributionPieChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Row 2: Monthly Trend -->
            <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100">
                <h2 class="text-lg font-semibold text-slate-700 mb-4">Monthly Attendance Trend (Present Counts)</h2>
                <canvas id="monthlyLineChart" height="100"></canvas>
            </div>

        </div>
    </main>

    <script>
        // Colors
        const COL_PRESENT = '#059669'; // Emerald 600
        const COL_LATE = '#d97706';    // Amber 600
        const COL_ABSENT = '#dc2626';  // Red 600
        const COL_BG_PRESENT = '#ecfdf5';
        const COL_BG_LATE = '#fffbeb';
        const COL_BG_ABSENT = '#fef2f2';

        document.addEventListener('DOMContentLoaded', async () => {
            // Sidebar Logic
            const openSidebar = document.getElementById('openSidebar');
            const closeSidebar = document.getElementById('closeSidebar');
            const sidebar = document.getElementById('adminSidebar');
            const overlay = document.getElementById('sidebarOverlay');

            if (openSidebar && sidebar && overlay) {
                openSidebar.addEventListener('click', () => {
                    overlay.classList.remove('hidden');
                    requestAnimationFrame(() => {
                        overlay.classList.remove('opacity-0');
                        sidebar.classList.remove('-translate-x-full');
                    });
                });

                const hideSidebar = () => {
                    overlay.classList.add('opacity-0');
                    sidebar.classList.add('-translate-x-full');
                    setTimeout(() => {
                        overlay.classList.add('hidden');
                    }, 300);
                };

                if (closeSidebar) closeSidebar.addEventListener('click', hideSidebar);
                overlay.addEventListener('click', hideSidebar);
            }

            // Fetch Daily Data
            const dailyRes = await fetch('/admin/api/stats/daily');
            const dailyData = await dailyRes.json();

            // Fetch Monthly Data
            const monthlyRes = await fetch('/admin/api/stats/monthly');
            const monthlyData = await monthlyRes.json();

            renderDailyBar(dailyData);
            renderDistributionPie(dailyData);
            renderMonthlyLine(monthlyData);
        });

        function renderDailyBar(data) {
            const ctx = document.getElementById('dailyBarChart').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Present', 'Late', 'Absent'],
                    datasets: [{
                        label: 'Staff Count',
                        data: [data.Present, data.Late, data.Absent],
                        backgroundColor: [COL_PRESENT, COL_LATE, COL_ABSENT],
                        borderRadius: 6,
                        barThickness: 40
                    }]
                },
                options: {
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true, grid: { display: false } }, x: { grid: { display: false } } }
                }
            });
        }

        function renderDistributionPie(data) {
            const ctx = document.getElementById('distributionPieChart').getContext('2d');
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Present', 'Late', 'Absent'],
                    datasets: [{
                        data: [data.Present, data.Late, data.Absent],
                        backgroundColor: [COL_PRESENT, COL_LATE, COL_ABSENT],
                        borderWidth: 0,
                        hoverOffset: 4
                    }]
                },
                options: {
                    plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, padding: 20 } } },
                    cutout: '70%'
                }
            });
        }

        function renderMonthlyLine(data) {
            const ctx = document.getElementById('monthlyLineChart').getContext('2d');

            // Transform {day, count} to arrays
            const labels = data.map(d => {
                const date = new Date(d.day);
                return date.getDate(); // Just the day number
            });
            const counts = data.map(d => d.count);

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Present Staff',
                        data: counts,
                        borderColor: '#4f46e5', // Indigo 600
                        backgroundColor: 'rgba(79, 70, 229, 0.1)',
                        tension: 0.4,
                        fill: true,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true }, x: { title: { display: true, text: 'Day of Month' } } }
                }
            });
        }
    </script>
</body>

</html>