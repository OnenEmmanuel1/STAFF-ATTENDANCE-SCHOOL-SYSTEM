<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>System Settings - Admin Portal</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = { theme: { extend: { fontFamily: { sans: ['Inter', 'sans-serif'] } } } }
    </script>
    <meta name="csrf-token" content="<%= csrfToken %>">
</head>

<body class="bg-slate-50 font-sans min-h-screen flex">

    <!-- Mobile Sidebar Overlay -->
    <div id="sidebarOverlay"
        class="fixed inset-0 bg-slate-900/50 z-20 hidden md:hidden backdrop-blur-sm transition-opacity duration-300 opacity-0">
    </div>

    <!-- Sidebar -->
    <aside id="adminSidebar"
        class="fixed inset-y-0 left-0 w-64 bg-slate-900 border-r border-slate-800 z-30 transform -translate-x-full md:translate-x-0 md:static md:flex md:flex-col transition-transform duration-300 ease-in-out">
        <div class="flex items-center justify-between h-16 px-6 border-b border-slate-800">
            <span class="text-white font-bold text-lg">Admin Portal</span>
            <button id="closeSidebar" class="md:hidden text-slate-400 hover:text-white">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <div class="flex flex-col flex-1 overflow-y-auto py-4">
            <nav class="space-y-1 px-2">
                <a href="/admin/dashboard"
                    class="flex items-center px-4 py-2.5 text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white rounded-lg transition-colors">Dashboard</a>
                <a href="/admin/staff"
                    class="flex items-center px-4 py-2.5 text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white rounded-lg transition-colors">Staff
                    Management</a>
                <a href="/admin/attendance"
                    class="flex items-center px-4 py-2.5 text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white rounded-lg transition-colors">Attendance
                    Logs</a>
                <a href="/admin/settings"
                    class="flex items-center px-4 py-2.5 text-sm font-medium bg-indigo-600 text-white rounded-lg transition-colors">Settings</a>
            </nav>
        </div>
        <div class="border-t border-slate-800 p-4"><a href="/admin/logout"
                class="text-sm font-medium text-slate-400 hover:text-white">Sign Out</a></div>
    </aside>

    <main class="flex-1 overflow-y-auto w-full">
        <header class="bg-white shadow-sm border-b border-slate-200 px-4 sm:px-8 py-4 sticky top-0 z-10">
            <div class="flex items-center gap-3">
                <button id="openSidebar" class="md:hidden text-slate-600 hover:text-slate-900 focus:outline-none">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
                <h1 class="text-xl font-bold text-slate-800">System Configuration</h1>
            </div>
        </header>

        <div class="p-8 max-w-3xl">
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
                <form id="settingsForm" class="space-y-6">
                    <div>
                        <h3 class="text-lg font-semibold text-slate-800 mb-1">Work Hours</h3>
                        <p class="text-sm text-slate-500 mb-4">Define the official working hours for staff.</p>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-slate-700 mb-1">Work Start Time</label>
                                <input type="time" id="workStart" required
                                    class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-slate-700 mb-1">Work End Time</label>
                                <input type="time" id="workEnd" required
                                    class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                            </div>
                        </div>
                    </div>

                    <div class="border-t border-slate-100 pt-6">
                        <h3 class="text-lg font-semibold text-slate-800 mb-1">Attendance Rules</h3>
                        <p class="text-sm text-slate-500 mb-4">Configure thresholds and validation rules.</p>

                        <div class="space-y-4">
                            <div>
                                <label class="block text-sm font-medium text-slate-700 mb-1">Late Threshold
                                    (Minutes)</label>
                                <input type="number" id="lateThreshold" required min="0"
                                    class="w-full max-w-xs px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                                <p class="text-xs text-slate-400 mt-1">Staff checking in after Start Time + Threshold
                                    will be marked Late.</p>
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-slate-700 mb-1">Allowed IP List (Comma
                                    Separated)</label>
                                <textarea id="ipRange" rows="3"
                                    class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none font-mono text-xs"></textarea>
                                <p class="text-xs text-slate-400 mt-1">Example: 127.0.0.1, 192.168.1.1. Leave empty to
                                    allow all.</p>
                            </div>
                        </div>
                    </div>

                    <div class="pt-4 flex items-center justify-end">
                        <span id="saveMessage" class="mr-4 text-sm font-medium text-green-600 hidden">✓ Settings
                            Saved</span>
                        <button type="submit"
                            class="px-6 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg shadow-md transition-colors">
                            Save Configuration
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            const res = await fetch('/admin/api/settings');
            const data = await res.json();

            document.getElementById('workStart').value = data.work_start_time;
            document.getElementById('workEnd').value = data.work_end_time;
            document.getElementById('lateThreshold').value = data.late_threshold_minutes;
            document.getElementById('ipRange').value = data.allowed_ip_range;

            // Sidebar Logic
            const openSidebar = document.getElementById('openSidebar');
            const closeSidebar = document.getElementById('closeSidebar');
            const sidebar = document.getElementById('adminSidebar');
            const overlay = document.getElementById('sidebarOverlay');

            if (openSidebar && sidebar && overlay) {
                openSidebar.addEventListener('click', () => {
                    overlay.classList.remove('hidden');
                    requestAnimationFrame(() => {
                        overlay.classList.remove('opacity-0');
                        sidebar.classList.remove('-translate-x-full');
                    });
                });

                const hideSidebar = () => {
                    overlay.classList.add('opacity-0');
                    sidebar.classList.add('-translate-x-full');
                    setTimeout(() => {
                        overlay.classList.add('hidden');
                    }, 300);
                };

                if (closeSidebar) closeSidebar.addEventListener('click', hideSidebar);
                overlay.addEventListener('click', hideSidebar);
            }
        });

        document.getElementById('settingsForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = e.target.querySelector('button');
            const msg = document.getElementById('saveMessage');

            btn.disabled = true;
            btn.textContent = 'Saving...';
            msg.classList.add('hidden');

            const body = {
                work_start_time: document.getElementById('workStart').value,
                work_end_time: document.getElementById('workEnd').value,
                late_threshold_minutes: document.getElementById('lateThreshold').value,
                allowed_ip_range: document.getElementById('ipRange').value
            };

            try {
                const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
                const res = await fetch('/admin/api/settings', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': csrfToken
                    },
                    body: JSON.stringify(body)
                });

                if (res.ok) {
                    msg.classList.remove('hidden');
                    setTimeout(() => msg.classList.add('hidden'), 3000);
                }
            } catch (err) {
                alert('Failed to save settings');
            } finally {
                btn.disabled = false;
                btn.textContent = 'Save Configuration';
            }
        });
    </script>
</body>

</html>