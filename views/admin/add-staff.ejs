<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Staff - Admin Portal</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = { theme: { extend: { fontFamily: { sans: ['Inter', 'sans-serif'] } } } }
    </script>
    <meta name="csrf-token" content="<%= csrfToken %>">
</head>

<body class="bg-slate-50 font-sans min-h-screen">

    <div class="max-w-2xl mx-auto py-12 px-4">

        <div class="mb-8">
            <a href="/admin/chat" class="text-sm text-slate-500 hover:text-indigo-600 flex items-center gap-1 mb-4">
                &larr; Back to Analyst Dashboard
            </a>
            <h1 class="text-3xl font-bold text-slate-800">Onboard New Staff</h1>
            <p class="text-slate-500 mt-2">Create a new account for a staff member. They will receive access
                immediately.</p>
        </div>

        <div class="bg-white rounded-2xl shadow-lg border border-slate-100 p-8">
            <form id="addStaffForm" class="space-y-6">

                <!-- Profile Picture Upload -->
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-2">Profile Picture (Optional)</label>
                    <div class="flex items-center gap-4">
                        <div class="w-16 h-16 rounded-full bg-indigo-50 border border-indigo-100 flex items-center justify-center overflow-hidden shrink-0" id="previewContainer">
                            <span id="previewFallback" class="text-indigo-400 font-semibold text-lg">📷</span>
                            <img id="imagePreview" class="w-full h-full object-cover hidden" alt="Preview">
                        </div>
                        <div class="flex-1">
                            <input type="file" id="profile_pic" name="profile_pic" accept="image/*"
                                class="w-full text-sm text-slate-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 cursor-pointer">
                            <p class="text-xs text-slate-400 mt-1">PNG, JPG, GIF or WEBP (Max 5MB)</p>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Full Name</label>
                        <input type="text" id="name" required
                            class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 outline-none transition-all"
                            placeholder="e.g. Jane Doe">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Email Address</label>
                        <input type="email" id="email" required
                            class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 outline-none transition-all"
                            placeholder="jane@school.edu">
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Department</label>
                    <select id="department"
                        class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 outline-none transition-all">
                        <option>Computer Science</option>
                        <option>Engineering</option>
                        <option>Business Admin</option>
                        <option>Mathematics</option>
                        <option>Physics</option>
                        <option>Human Resources</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Temporary Password</label>
                    <input type="password" id="password" required
                        class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 outline-none transition-all"
                        placeholder="••••••••">
                    <p class="text-xs text-slate-400 mt-1">Staff is advised to change this upon first login.</p>
                </div>

                <div class="pt-4">
                    <div id="msg" class="hidden mb-4 p-4 rounded-xl text-sm font-medium text-center"></div>
                    <button type="submit"
                        class="w-full py-4 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-lg shadow-indigo-200 transition-transform active:scale-95">
                        Create Account
                    </button>
                </div>

            </form>
        </div>

    </div>

    <script>
        // Image preview logic
        document.getElementById('profile_pic').addEventListener('change', (e) => {
            const file = e.target.files[0];
            const imgPreview = document.getElementById('imagePreview');
            const fallback = document.getElementById('previewFallback');

            if (file) {
                const reader = new FileReader();
                reader.onload = (event) => {
                    imgPreview.src = event.target.result;
                    imgPreview.classList.remove('hidden');
                    fallback.classList.add('hidden');
                };
                reader.readAsDataURL(file);
            } else {
                imgPreview.src = '';
                imgPreview.classList.add('hidden');
                fallback.classList.remove('hidden');
            }
        });

        document.getElementById('addStaffForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = e.target.querySelector('button');
            const msg = document.getElementById('msg');

            const formData = new FormData();
            formData.append('name', document.getElementById('name').value);
            formData.append('email', document.getElementById('email').value);
            formData.append('department', document.getElementById('department').value);
            formData.append('password', document.getElementById('password').value);

            const fileInput = document.getElementById('profile_pic');
            if (fileInput.files.length > 0) {
                formData.append('profile_pic', fileInput.files[0]);
            }

            btn.disabled = true;
            btn.textContent = 'Creating Account...';
            msg.className = 'hidden mb-4 p-4 rounded-xl text-sm font-medium text-center';

            try {
                const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
                const res = await fetch('/admin/api/staff/create', {
                    method: 'POST',
                    headers: {
                        'X-CSRF-Token': csrfToken
                    },
                    body: formData
                });
                const data = await res.json();

                if (res.ok) {
                    msg.textContent = '✓ Staff Account Created Successfully';
                    msg.classList.add('bg-green-50', 'text-green-700', 'border', 'border-green-100');
                    msg.classList.remove('hidden');
                    e.target.reset();
                    document.getElementById('imagePreview').classList.add('hidden');
                    document.getElementById('previewFallback').classList.remove('hidden');
                    if (typeof showToast === 'function') {
                        showToast('Staff Account Created Successfully!', 'success');
                    }
                } else {
                    msg.textContent = '✕ ' + (data.error || 'Failed to create account');
                    msg.classList.add('bg-red-50', 'text-red-700', 'border', 'border-red-100');
                    msg.classList.remove('hidden');
                    if (typeof showToast === 'function') {
                        showToast(data.error || 'Failed to create account', 'error');
                    }
                }
            } catch (err) {
                msg.textContent = '✕ Connection Error';
                msg.classList.add('bg-red-50', 'text-red-700');
                msg.classList.remove('hidden');
                if (typeof showToast === 'function') {
                    showToast('Connection Error. Please try again.', 'error');
                }
            } finally {
                btn.disabled = false;
                btn.textContent = 'Create Account';
            }
        });
    </script>
    <script src="/js/toast.js"></script>
</body>

</html>