<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analyst AI - Admin Portal</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .scrollbar-hide::-webkit-scrollbar {
            display: none;
        }

        .slide-up {
            animation: slideUp 0.3s ease-out;
        }

        @keyframes slideUp {
            from {
                transform: translateY(10px);
                opacity: 0;
            }

            to {
                transform: translateY(0);
                opacity: 1;
            }
        }
    </style>
    <meta name="csrf-token" content="<%= csrfToken %>">
</head>

<body class="bg-slate-900 font-sans min-h-screen flex flex-col items-center justify-center text-slate-200">

    <!-- Top Bar -->
    <div class="fixed top-0 w-full bg-slate-900/80 backdrop-blur-md border-b border-slate-800 p-4 z-50">
        <div class="max-w-4xl mx-auto flex justify-between items-center">
            <div class="flex items-center gap-2">
                <a href="/admin/dashboard"
                    class="w-8 h-8 rounded-lg bg-indigo-500 flex items-center justify-center font-bold text-white hover:bg-indigo-600 transition-colors">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                    </svg>
                </a>
                <span class="font-semibold text-white hidden xs:inline">Analyst</span>
            </div>
            <nav class="flex gap-4 text-sm font-medium">
                <a href="/admin/staff" class="hover:text-white transition-colors">Staff</a>
                <a href="/admin/attendance" class="hover:text-white transition-colors">Logs</a>
                <a href="/admin/settings" class="hover:text-white transition-colors hidden sm:inline">Settings</a>
                <a href="/admin/logout" class="text-red-400 hover:text-red-300 transition-colors">Logout</a>
            </nav>
        </div>
    </div>

    <!-- Chat Container -->
    <main class="w-full max-w-2xl px-4 flex-1 flex flex-col pt-24 pb-24">

        <!-- Welcome Message -->
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-white mb-2">Hello, Admin.</h1>
            <p class="text-slate-400">Ask me anything about today's attendance or system status.</p>
        </div>

        <!-- Messages Area -->
        <div id="messages" class="flex-1 overflow-y-auto space-y-6 scrollbar-hide pb-4">
            <!-- Initial Bot Message -->
            <div class="flex gap-4">
                <div class="w-8 h-8 rounded-full bg-indigo-600 flex-shrink-0 flex items-center justify-center text-xs">
                    AI</div>
                <div class="space-y-2">
                    <div class="bg-slate-800 rounded-2xl rounded-tl-none px-5 py-3 text-sm text-slate-200 shadow-md">
                        System is online. tracking <strong>Active</strong> status.
                        <br>Try asking:
                        <span class="text-indigo-400 cursor-pointer hover:underline"
                            onclick="sendQuery('System Stats')">"System Stats"</span>,
                        <span class="text-indigo-400 cursor-pointer hover:underline"
                            onclick="sendQuery('Who is late?')">"Who is late?"</span>
                    </div>
                </div>
            </div>
        </div>

    </main>

    <!-- Input Area -->
    <div class="fixed bottom-0 w-full bg-slate-900/90 backdrop-blur-xl border-t border-slate-800 p-4">
        <div class="max-w-2xl mx-auto relative">
            <form id="chatForm" class="relative">
                <input type="text" id="userInput" placeholder="Ask a question..."
                    class="w-full bg-slate-800 text-white placeholder-slate-500 rounded-2xl pl-5 pr-12 py-4 focus:ring-2 focus:ring-indigo-500 outline-none shadow-lg border border-slate-700">
                <button type="submit"
                    class="absolute right-3 top-3 p-1.5 bg-indigo-500 hover:bg-indigo-600 rounded-xl text-white transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                        stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M5 10l7-7m0 0l7 7m-7-7v18" />
                    </svg>
                </button>
            </form>
        </div>
    </div>

    <script>
        const messagesDiv = document.getElementById('messages');
        const form = document.getElementById('chatForm');
        const input = document.getElementById('userInput');

        function appendUserMessage(text) {
            const div = document.createElement('div');
            div.className = 'flex gap-4 flex-row-reverse slide-up';
            div.innerHTML = `
                <div class="w-8 h-8 rounded-full bg-slate-700 flex-shrink-0 flex items-center justify-center text-xs">Me</div>
                <div class="bg-indigo-600 rounded-2xl rounded-tr-none px-5 py-3 text-sm text-white shadow-md max-w-[80%]">
                    ${text}
                </div>
            `;
            messagesDiv.appendChild(div);
            scrollToBottom();
        }

        function appendBotResponse(data) {
            const div = document.createElement('div');
            div.className = 'flex gap-4 slide-up';

            let contentHtml = `<p>${data.content}</p>`;

            // Render Stats Card
            if (data.type === 'stats') {
                contentHtml += `
                    <div class="grid grid-cols-2 gap-3 mt-3">
                        <div class="bg-slate-900/50 p-3 rounded-xl border border-slate-700 text-center">
                            <div class="text-xs text-slate-500">Present</div>
                            <div class="text-xl font-bold text-green-400">${data.data.present}</div>
                        </div>
                        <div class="bg-slate-900/50 p-3 rounded-xl border border-slate-700 text-center">
                            <div class="text-xs text-slate-500">Late</div>
                            <div class="text-xl font-bold text-amber-400">${data.data.late}</div>
                        </div>
                        <div class="bg-slate-900/50 p-3 rounded-xl border border-slate-700 text-center">
                            <div class="text-xs text-slate-500">Absent</div>
                            <div class="text-xl font-bold text-red-400">${data.data.absent}</div>
                        </div>
                        <div class="bg-slate-900/50 p-3 rounded-xl border border-slate-700 text-center">
                            <div class="text-xs text-slate-500">Total</div>
                            <div class="text-xl font-bold text-white">${data.data.total}</div>
                        </div>
                    </div>
                `;
            }

            // Render List
            if (data.type === 'list') {
                contentHtml += `
                    <div class="mt-3 bg-slate-900/50 rounded-xl border border-slate-700 overflow-hidden">
                        <div class="bg-slate-800/50 px-4 py-2 text-xs font-semibold text-slate-400 uppercase tracking-wider">${data.title}</div>
                        <ul class="divide-y divide-slate-800">
                            ${data.items.map(item => `<li class="px-4 py-2 text-sm text-slate-300">${item}</li>`).join('')}
                        </ul>
                    </div>
                `;
            }

            // Render Action Link
            if (data.type === 'action_link') {
                contentHtml += `
                    <a href="${data.url}" class="mt-3 inline-block px-4 py-2 bg-indigo-500 hover:bg-indigo-600 text-white rounded-lg text-sm font-medium transition-colors">
                        ${data.text} &rarr;
                    </a>
                `;
            }

            div.innerHTML = `
                <div class="w-8 h-8 rounded-full bg-indigo-600 flex-shrink-0 flex items-center justify-center text-xs">AI</div>
                <div class="space-y-2 max-w-[85%]">
                    <div class="bg-slate-800 rounded-2xl rounded-tl-none px-5 py-3 text-sm text-slate-200 shadow-md">
                        ${contentHtml}
                    </div>
                </div>
            `;
            messagesDiv.appendChild(div);
            scrollToBottom();
        }

        function scrollToBottom() {
            messagesDiv.scrollTop = messagesDiv.scrollHeight;
        }

        async function sendQuery(text) {
            appendUserMessage(text);

            try {
                const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
                const res = await fetch('/admin/api/chat', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': csrfToken
                    },
                    body: JSON.stringify({ message: text })
                });
                const data = await res.json();
                appendBotResponse(data);
            } catch (e) {
                appendBotResponse({ content: 'Error connecting to the analyst core.' });
            }
        }

        form.addEventListener('submit', (e) => {
            e.preventDefault();
            const text = input.value.trim();
            if (text) {
                sendQuery(text);
                input.value = '';
            }
        });
    </script>
</body>

</html>